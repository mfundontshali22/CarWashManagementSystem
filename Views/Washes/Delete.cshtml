@model CarWashOps.Models.Wash
@{
    ViewData["Title"] = "Delete Wash";
}

<div class="page-head">
    <div><h1>Delete Wash</h1><p>Are you sure you want to delete this record?</p></div>
</div>

<div class="form-card">
    <dl class="row mb-0">
        <dt class="col-sm-4">Car</dt><dd class="col-sm-8">@Model.CarName</dd>
        <dt class="col-sm-4">Date / Time</dt><dd class="col-sm-8">@Model.WashDate.ToString("dd MMM yyyy") &middot; @Model.WashTime.ToString(@"hh\:mm")</dd>
        <dt class="col-sm-4">Employee</dt><dd class="col-sm-8">@(Model.Employee?.EmployeeName ?? "Unassigned")</dd>
        <dt class="col-sm-4">Client</dt><dd class="col-sm-8">@(Model.Client?.ClientName ?? "Walk-in")</dd>
    </dl>

    <form asp-action="Delete" class="mt-4">
        <input type="hidden" asp-for="CarId" />
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            <button type="submit" class="btn btn-danger">Delete Wash</button>
        </div>
    </form>
</div>
