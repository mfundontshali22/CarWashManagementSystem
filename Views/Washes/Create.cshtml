@model CarWashOps.Models.Wash
@{
    ViewData["Title"] = "Log a Wash";
}

<div class="page-head">
    <div><h1>Log a Wash</h1><p>Add a new car to the wash bay.</p></div>
</div>

<div class="form-card">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="CarName" class="form-label"></label>
            <input asp-for="CarName" class="form-control" placeholder="e.g. Toyota Corolla" />
            <span asp-validation-for="CarName" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col mb-3">
                <label asp-for="LicensePlate" class="form-label"></label>
                <input asp-for="LicensePlate" class="form-control" placeholder="e.g. ND 12 34 GP" />
            </div>
            <div class="col mb-3">
                <label asp-for="WashTime" class="form-label"></label>
                <input asp-for="WashTime" type="time" class="form-control" />
                <span asp-validation-for="WashTime" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="WashDate" class="form-label"></label>
            <input asp-for="WashDate" type="date" class="form-control" value="@Model.WashDate.ToString("yyyy-MM-dd")" />
        </div>

        <div class="mb-3">
            <label class="form-label">Client</label>
            <select name="ClientId" asp-items="ViewBag.ClientId" class="form-select">
                <option value="">Walk-in / none</option>
            </select>
        </div>

        <div class="row">
            <div class="col mb-3">
                <label class="form-label">Service Type</label>
                <select name="ServiceType" asp-items="ViewBag.ServiceTypes" class="form-select"></select>
            </div>
            <div class="col mb-3">
                <label asp-for="Price" class="form-label"></label>
                <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" />
            </div>
        </div>

        <div class="row">
            <div class="col mb-3">
                <label class="form-label">Employee Responsible</label>
                <select name="EmployeeNum" asp-items="ViewBag.EmployeeNum" class="form-select">
                    <option value="">Unassigned</option>
                </select>
            </div>
            <div class="col mb-3">
                <label class="form-label">Status</label>
                <select name="Status" asp-items="ViewBag.StatusOptions" class="form-select"></select>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-3">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Save Wash</button>
        </div>
    </form>
</div>
