@model CarWashOps.Models.Employee
@{
    ViewData["Title"] = "Delete Employee";
}

<div class="page-head"><div><h1>Delete Employee</h1><p>Are you sure you want to delete this employee?</p></div></div>

<div class="form-card">
    <dl class="row mb-0">
        <dt class="col-sm-4">Name</dt><dd class="col-sm-8">@Model.EmployeeName</dd>
        <dt class="col-sm-4">Service Type</dt><dd class="col-sm-8">@Model.ServiceType</dd>
    </dl>
    <p class="text-muted small mt-2">Past washes handled by this employee will remain, marked as "Unassigned".</p>

    <form asp-action="Delete" class="mt-3">
        <input type="hidden" asp-for="EmployeeNum" />
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            <button type="submit" class="btn btn-danger">Delete Employee</button>
        </div>
    </form>
</div>
