@model CarWashOps.Models.Employee
@{
    ViewData["Title"] = "Add Employee";
}

<div class="page-head"><div><h1>Add Employee</h1><p>Add a new team member.</p></div></div>

<div class="form-card">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="EmployeeName" class="form-label"></label>
            <input asp-for="EmployeeName" class="form-control" placeholder="e.g. Sipho Ndlovu" />
            <span asp-validation-for="EmployeeName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ServiceType" class="form-label"></label>
            <select asp-for="ServiceType" class="form-select">
                <option>Exterior Wash</option>
                <option>Full Valet</option>
                <option>Interior Detail</option>
                <option>Wax &amp; Polish</option>
                <option>Supervisor</option>
                <option>General</option>
            </select>
        </div>

        <div class="row">
            <div class="col mb-3">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" placeholder="e.g. 083 555 0192" />
            </div>
            <div class="col mb-3">
                <label class="form-label">Status</label>
                <select name="Status" asp-items="ViewBag.StatusOptions" class="form-select"></select>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-3">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Save Employee</button>
        </div>
    </form>
</div>
