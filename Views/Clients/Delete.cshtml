@model CarWashOps.Models.Client
@{
    ViewData["Title"] = "Delete Client";
}

<div class="page-head"><div><h1>Delete Client</h1><p>Are you sure you want to delete this client?</p></div></div>

<div class="form-card">
    <dl class="row mb-0">
        <dt class="col-sm-4">Name</dt><dd class="col-sm-8">@Model.ClientName</dd>
        <dt class="col-sm-4">Phone</dt><dd class="col-sm-8">@(Model.Phone ?? "—")</dd>
    </dl>
    <p class="text-muted small mt-2">Past washes for this client will remain, marked as "Walk-in".</p>

    <form asp-action="Delete" class="mt-3">
        <input type="hidden" asp-for="ClientId" />
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            <button type="submit" class="btn btn-danger">Delete Client</button>
        </div>
    </form>
</div>
