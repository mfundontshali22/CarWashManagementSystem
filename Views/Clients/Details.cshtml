@model CarWashOps.Models.Client
@{
    ViewData["Title"] = "Client Details";
}

<div class="page-head"><div><h1>@Model.ClientName</h1><p>Client #@Model.ClientId</p></div></div>

<div class="form-card">
    <dl class="row mb-0">
        <dt class="col-sm-4">Phone</dt><dd class="col-sm-8">@(Model.Phone ?? "—")</dd>
        <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@(Model.Email ?? "—")</dd>
        <dt class="col-sm-4">License Plate</dt><dd class="col-sm-8">@(Model.LicensePlate ?? "—")</dd>
        <dt class="col-sm-4">Notes</dt><dd class="col-sm-8">@(Model.Notes ?? "—")</dd>
        <dt class="col-sm-4">Total Visits</dt><dd class="col-sm-8">@(Model.Washes?.Count ?? 0)</dd>
    </dl>
    <div class="d-flex gap-2 mt-4">
        <a class="btn btn-outline-secondary" asp-action="Index">Back to Clients</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.ClientId">Edit</a>
    </div>
</div>
